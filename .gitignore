sim/assets/**/*_generated.xml

# ---------------------------------------------------------------------------
# Model checkpoints, exports, OpenVINO IR
# ---------------------------------------------------------------------------
outputs/
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
# OpenVINO IR lives under outputs/ (already ignored above) -- regenerate it from
# the checkpoint rather than committing policy.xml / policy.bin.

# ---------------------------------------------------------------------------
# Datasets (LeRobot, demonstrations, recordings)
# ---------------------------------------------------------------------------
# Note: 'data/*' not 'data/' -- git does not descend into an excluded
# directory, so a negation inside one would never match.
data/*
!data/.gitkeep
!data/__init__.py
!data/dataloader.py
!data/check_dataset.py
*.parquet
*.hdf5
*.h5
*.lerobot/
.cache/
.huggingface/

# Demo / eval media
*.mp4
*.mkv
*.webm
*.gif

# ---------------------------------------------------------------------------
# Secrets and local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.secrets/

# ---------------------------------------------------------------------------
# Node (optional web viewer under apps/web)
# ---------------------------------------------------------------------------
node_modules/
.next/
.turbo/
*.tsbuildinfo

