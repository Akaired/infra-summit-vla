<mujoco model="dinner_table_dual_so101_placeholder">
  <!--
    PLACEHOLDER RIG - not the real SO-101 MJCF.

    Purpose: unblock everyone else (policy/inference/eval) with a scene that
    already satisfies the sim.yaml contract:
      - joint/body names prefixed left_ / right_ (robot.left_arm_prefix etc.)
      - object body names match sim.yaml `objects:` exactly
      - camera names match sim.yaml `cameras:` exactly (overhead, wrist_left, wrist_right)

    Swap plan: once a real SO-101 MJCF exists (or gym-aloha is adopted),
    replace the two <body name="left_arm_base".../> / right_arm_base subtrees
    below. Nothing outside this file should need to change, because /sim,
    /policy, /inference, /eval only ever talk to names, not this geometry.

    Arm model: 5 revolute joints + 1 prismatic gripper per arm, built from
    primitive capsules/boxes. Rough SO-101-like proportions (small desktop
    arm), not a kinematic match to the real hardware.
  -->
  <compiler angle="radian" meshdir="ycb/" texturedir="ycb/"/>

  <option integrator="implicitfast"/>

  <visual>
    <map znear="0.001" zfar="20"/>
  </visual>

  <default>
    <default class="arm_link">
      <joint armature="0.01" damping="0.5" frictionloss="0.05"/>
      <geom size="0.02 0 0" type="capsule" rgba="0.7 0.7 0.75 1" density="1200"/>
    </default>
    <default class="gripper_finger">
      <joint type="slide" range="0 0.04" damping="1"/>
      <geom type="box" rgba="0.2 0.2 0.2 1" density="1200"/>
    </default>
    <default class="manip_object">
      <joint type="free" damping="0.001"/>
      <geom friction="0.9 0.01 0.001" density="500"/>
    </default>
    <default class="left_main">
      <default class="left_so101_new_calib">
        <joint armature="0.005" damping="1" frictionloss="0.1"/>
        <general biastype="affine" gainprm="50" biasprm="0 -50"/>
        <default class="left_visual">
          <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="left_collision">
          <geom group="3"/>
        </default>
      </default>
      <default class="left_sts3215">
        <joint armature="0.028" damping="0.6" frictionloss="0.052"/>
        <geom contype="0" conaffinity="0"/>
        <general forcerange="-2.94 2.94" biastype="affine" gainprm="998.22" biasprm="0 -998.22 -2.731"/>
      </default>
      <default class="left_backlash">
        <joint range="-0.00872665 0.00872665" armature="0.01" damping="0.01" limited="true"/>
      </default>
    </default>
    <default class="right_main">
      <default class="right_so101_new_calib">
        <joint armature="0.005" damping="1" frictionloss="0.1"/>
        <general biastype="affine" gainprm="50" biasprm="0 -50"/>
        <default class="right_visual">
          <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="right_collision">
          <geom group="3"  friction="2.5 0.05 0.001"/>
        </default>
      </default>
      <default class="right_sts3215">
        <joint armature="0.028" damping="0.6" frictionloss="0.052"/>
        <geom contype="0" conaffinity="0"/>
        <general forcerange="-2.94 2.94" biastype="affine" gainprm="998.22" biasprm="0 -998.22 -2.731"/>
      </default>
      <default class="right_backlash">
        <joint range="-0.00872665 0.00872665" armature="0.01" damping="0.01" limited="true"/>
      </default>
    </default>
  </default>

